<?xml version="1.0" encoding="UTF-8" ?>
<publication>
<!-- directories are relative to the main source PreTeXt file -->
<source>
    <directories external="../assets" generated="../generated-assets"/>
    <version include="instructor"/> <!-- instructor asides -->
</source>
    <numbering>
    <blocks level="2"/>
    <projects level="2"/>
    <equations level="2"/>
    <footnotes level="2"/>
  </numbering>
  <html>
    <!-- Whether to knowl a particular elements is set here    -->
    <!-- Lots of elements have this possibility; see the guide -->
    <knowl remark="no" example="no" proof="no"  exercise-inline="no" aside="no"/>
<!--     <css theme="denver" color-meta="#ffcccc" palette="primaries" color-fact="#009999" color-do="#9966ff" color-main="#006699"/>  Denver sets off inline exercises -->
    <css theme="default-modern"/>  <!-- denver sets off inline exercises -->
     </html>
</publication>
